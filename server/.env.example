# Port the Whiskr API listens on (default 5000).
PORT=5000

# WooCommerce is not connected in this build. Leave this unset/false so the
# sync endpoint reports the real connection state instead of faking a success.
# Set to true only once real store credentials are wired up server-side.
WOOCOMMERCE_CONNECTED=false

# --- WooCommerce credentials (server-side only — never expose to React) ---
# WOO_STORE_URL=https://your-store.example.com
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=

# --- Whiskr AI Product Assistant (server-side only) ---
# Required for POST /api/ai/suggestions. Leave unset and the endpoint returns
# an honest 503 while the deterministic quality checker keeps working.
# Never commit the real key (.env is gitignored) and never expose it to React.
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
